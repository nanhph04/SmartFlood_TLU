@prefix ex: <http://example.org/flood#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix schema: <https://schema.org/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix fiware: <https://smartdatamodels.org/dataModel.Environment/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

####################################################################
# CLASSES
####################################################################

ex:FloodSensor a rdfs:Class ;
    rdfs:subClassOf sosa:Sensor ;
    rdfs:label "Cảm biến mực nước đô thị"@vi ;
    rdfs:comment "Thiết bị đo mực nước, đặt tại vị trí cố định hoặc di động."@vi .

ex:FloodObservation a rdfs:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "Quan sát mực nước"@vi ;
    rdfs:comment "Quan sát kết quả đo mực nước từ cảm biến hoặc nguồn dữ liệu khác."@vi .

ex:WeatherObservation a rdfs:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "Quan sát thời tiết"@vi .

ex:CitizenReport a rdfs:Class ;
    rdfs:subClassOf schema:Report ;
    rdfs:label "Phản ánh của người dân"@vi ;
    rdfs:comment "Báo cáo do công dân gửi (văn bản, ảnh, tọa độ, thời gian)."@vi .

ex:FloodEvent a rdfs:Class ;
    rdfs:subClassOf fiware:FloodEvent ;
    owl:equivalentClass fiware:FloodEvent ;
    rdfs:label "Sự kiện ngập đô thị"@vi ;
    rdfs:comment "Sự kiện ngập tổng hợp từ nhiều quan sát và báo cáo."@vi .

ex:MonitoringArea a rdfs:Class ;
    rdfs:subClassOf sosa:FeatureOfInterest ;
    rdfs:label "Khu vực giám sát"@vi ;
    rdfs:comment "Khu vực (vùng, điểm, lưới) nơi thu thập quan sát."@vi .

ex:SeverityLevel a rdfs:Class ;
    rdfs:label "Mức độ nghiêm trọng"@vi .

####################################################################
# PROPERTIES
####################################################################

ex:waterLevel a rdf:Property ;
    rdfs:domain ex:FloodObservation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Mực nước đo được (mét)"@vi .

ex:rainLevel a rdf:Property ;
    rdfs:domain ex:WeatherObservation ;
    rdfs:range xsd:decimal ;
    rdfs:label "Lượng mưa (mm)"@vi .

ex:relatedEvent a rdf:Property ;
    rdfs:domain ex:FloodObservation ;
    rdfs:range ex:FloodEvent ;
    rdfs:label "Liên kết đến sự kiện ngập"@vi .

ex:reportedBy a rdf:Property ;
    rdfs:domain ex:CitizenReport ;
    rdfs:range schema:Person ;
    rdfs:label "Người gửi phản ánh"@vi .

ex:severity a rdf:Property ;
    rdfs:domain ex:FloodEvent ;
    rdfs:range ex:SeverityLevel ;
    rdfs:label "Mức độ nghiêm trọng"@vi .

ex:isCausedBy a rdf:Property ;
    rdfs:domain ex:FloodEvent ;
    rdfs:range ex:FloodEvent ;
    rdfs:label "Nguyên nhân gây ra"@vi ;
    rdfs:comment "Liên kết tới sự kiện nguyên nhân như ex:HeavyRainEvent."@vi .

ex:reportedAt a rdf:Property ;
    rdfs:domain ex:CitizenReport ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf schema:dateCreated ;
    rdfs:label "Thời điểm tạo báo cáo"@vi .

# FiWARE extension properties
fiware:dateObserved a rdf:Property ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:dateTime ;
    rdfs:label "Thời gian quan sát (FiWARE)"@vi .

fiware:refDevice a rdf:Property ;
    rdfs:domain sosa:Observation ;
    rdfs:range sosa:Sensor ;
    rdfs:label "Tham chiếu thiết bị (FiWARE)"@vi .

fiware:refArea a rdf:Property ;
    rdfs:domain sosa:Observation ;
    rdfs:range sosa:FeatureOfInterest ;
    rdfs:label "Tham chiếu khu vực (FiWARE)"@vi .
